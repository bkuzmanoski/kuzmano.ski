# Copy to `.env`; this file is git-ignored.

# Public address shown in the contact window and copied by its copy button.
# Injected into the client bundle at build time.
VITE_CONTACT_EMAIL_ADDRESS="inbox@example.com"

# Verified Email Routing destination for the Worker. Used by Wrangler locally.
# In production, set the `CONTACT_EMAIL_ADDRESS` secret:
#
#   wrangler secret put CONTACT_EMAIL_ADDRESS
#
CONTACT_EMAIL_ADDRESS="inbox@example.com"
