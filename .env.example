# Copy to `.env`; this file is git-ignored.

# Verified Email Routing destination for the Worker. Used by Wrangler locally.
# In production, set the `CONTACT_EMAIL_ADDRESS` secret:
#
#   wrangler secret put CONTACT_EMAIL_ADDRESS
#
CONTACT_EMAIL_ADDRESS="inbox@example.com"

# Notion integration token, and the data source ID of the waitlist database. Used
# by Wrangler locally. In production, set them as secrets:
#
#   wrangler secret put NOTION_TOKEN
#   wrangler secret put WAITLIST_DATA_SOURCE_ID
#
# This data source ID is used when joining a waitlist in development. It should
# be different from the production data source ID set as a secret.
NOTION_TOKEN="ntn_0000000000000000000000000000000000000000000"
WAITLIST_DATA_SOURCE_ID="00000000-0000-0000-0000-000000000000"
