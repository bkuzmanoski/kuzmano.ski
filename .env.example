# The verified destination email address contact messages are sent to. Used by
# Wrangler locally. In production, set it as a secret:
#
#   npm exec -- wrangler secret put CONTACT_EMAIL_ADDRESS
#
CONTACT_EMAIL_ADDRESS="inbox@example.com"

# The Notion connection access token, and the data source ID of the waitlist
# database. Used by Wrangler locally. In production, set them as secrets:
#
#   npm exec -- wrangler secret put NOTION_TOKEN
#   npm exec -- wrangler secret put WAITLIST_DATA_SOURCE_ID
#
NOTION_TOKEN="ntn_0000000000000000000000000000000000000000000"
WAITLIST_DATA_SOURCE_ID="00000000-0000-0000-0000-000000000000"

# The GitHub personal access token used to read the contribution calendar shown
# on the About page. Used by Wrangler locally. In production, set it as a secret:
#
#   npm exec -- wrangler secret put GITHUB_TOKEN
#
GITHUB_TOKEN="github_pat_0000000000000000000000_00000000000000000000000000000000000000000000000000000000000"
