{
  "name": "kuzmano.ski",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "vite dev --port 3000",
    "lint": "prettier --check . && eslint . --max-warnings=0 && stylelint '**/*.css' && markdownlint-cli2",
    "lint:fix": "prettier --write . && eslint --fix . && stylelint --fix '**/*.css' && markdownlint-cli2 --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist .output .tanstack .wrangler/tmp node_modules/.vite node_modules/.cache/jiti && find . -name node_modules -prune -o -name .git -prune -o -type f -name '*.tmp' -exec rm -f {} +",
    "prepare-media": "node scripts/prepare-media.ts",
    "optimize-image": "node scripts/optimize-image.ts",
    "encode-video": "node scripts/encode-video.ts",
    "convert-image": "node scripts/convert-image.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --diff-filter=ACMRD"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.30",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@csstools/postcss-color-mix-function": "^4.0.11",
    "@csstools/postcss-oklab-function": "^5.0.11",
    "@csstools/postcss-relative-color-syntax": "^4.0.11",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@shikijs/rehype": "^4.3.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/xast": "^2.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-select": "^6.0.4",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "jiti": "^2.7.0",
    "jsdom": "^28.1.0",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.0.7",
    "markdownlint-cli2": "^0.23.1",
    "mp4box": "^2.4.1",
    "postcss": "^8.5.15",
    "postcss-preset-env": "^11.3.0",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "rolldown": "^1.2.4",
    "sharp": "^0.35.3",
    "sharp-ico": "^0.1.5",
    "simple-git-hooks": "^2.13.1",
    "srcset": "^5.0.3",
    "stylelint": "^17.13.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.112.0",
    "xast-util-to-xml": "^4.0.0",
    "xastscript": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false,
    "sharp@0.35.3": true,
    "simple-git-hooks@2.13.1": true
  }
}
