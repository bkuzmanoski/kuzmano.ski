{
  "name": "kuzmano.ski",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "vite dev --port 3000",
    "lint": "prettier --check . && eslint . --max-warnings=0 && stylelint '**/*.css' && markdownlint-cli2",
    "lint:fix": "prettier --write . && eslint --fix . && stylelint --fix '**/*.css' && markdownlint-cli2 --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "build": "vite build",
    "generate:icons": "node scripts/generate-icons.ts",
    "preview": "vite preview"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,md,mdx}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ],
    "*.{md,mdx}": [
      "markdownlint-cli2 --fix"
    ]
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.30",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@shikijs/rehype": "^4.3.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "hast-util-to-string": "^3.0.1",
    "jiti": "^2.7.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.0.7",
    "markdownlint-cli2": "^0.23.1",
    "postcss": "^8.5.15",
    "postcss-preset-env": "^11.3.0",
    "prettier": "^3.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "sharp": "^0.35.3",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.13.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.112.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false,
    "sharp@0.35.3": true,
    "simple-git-hooks@2.13.1": true
  }
}
