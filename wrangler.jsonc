{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuzmano-ski",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/worker.js",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    // Route documents and `.md` files through the Worker for `text/markdown` responses; let the
    // Asset Worker serve all other assets without a Worker invocation. `*` matches across `/`.
    //
    // Exclude Vite output and media by directory because their hashed file types vary. Exclude
    // root assets by extension so new icons, feeds, and manifests do not need rule changes. Do not
    // use `!/*.*`: negative rules cannot be overridden, which would prevent `.md` handling.
    //
    // Documents vary by `Accept`, but Cloudflare caches only by `Accept-Encoding`. Do not add a
    // Cache Rule or `cacheEverything` unless the cache key also includes `Accept`.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/media/*",
      "!/*.html",
      "!/*.ico",
      "!/*.json",
      "!/*.png",
      "!/*.svg",
      "!/*.txt",
      "!/*.xml"
    ]
  },
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "SEND_EMAIL_RATELIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CONTACT_EMAIL_ADDRESS_RATELIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "WAITLIST_RATELIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
